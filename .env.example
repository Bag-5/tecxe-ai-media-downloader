# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Bag-5)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Google Cloud — YouTube Data API v3, for natural-language search
# Enable "YouTube Data API v3" at https://console.cloud.google.com/apis/library
YOUTUBE_API_KEY=""

# Optional: where media lands. Defaults to <repo>/Downloads
# MEDIA_ROOT="C:\Users\You\Desktop\TECXE AI-Media Downloader\Downloads"

# Optional: model override
# AI_PRIMARY_MODEL="openai/gpt-oss-120b"
# AI_FALLBACK_MODEL="openai/gpt-oss-20b"